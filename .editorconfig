root=true

[*]
end_of_line=lf
charset=utf-8
trim_tailing_whitespace=true
insert_final_newline=true
indent_style=space
indent_size=4

[*.map]
end_of_line=lf
charset=latin1
indent_style=tab
trim_tailing_whitespace=true
insert_final_newline=true

[*.in]
end_of_line=lf
charset=latin1
indent_style=tab
trim_tailing_whitespace=true
insert_final_newline=true

[Makefile]
indent_style=tab
